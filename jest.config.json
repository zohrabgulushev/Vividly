{
  "testEnvironment": "node",
  "testMatch": [
    "**/__tests__/**/*.test.ts",
    "**/__tests__/**/*.test.tsx"
  ],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "tsconfig": "__tests__/tsconfig.json"
    }]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/android/",
    "/ios/"
  ],
  "collectCoverageFrom": [
    "src/services/**/*.ts"
  ]
}
