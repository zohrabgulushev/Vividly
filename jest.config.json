{
  "preset": "jest-expo",
  "testEnvironment": "node",
  "testMatch": [
    "**/__tests__/**/*.test.ts",
    "**/__tests__/**/*.test.tsx"
  ],
  "transform": {
    "^.+\\.(ts|tsx)$": "babel-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/android/",
    "/ios/"
  ],
  "collectCoverageFrom": [
    "src/services/**/*.ts",
    "src/hooks/**/*.ts",
    "src/app/**/*.tsx"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 70,
      "lines": 70
    }
  }
}
